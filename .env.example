# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase — from `supabase start` (local) or the project API settings (cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — use ONLY in trusted server code, never shipped
# to the browser. Needed for admin tasks / the seed helpers if you script them.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (transactional email)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL="SKM <onboarding@resend.dev>"

# Owner inbox that receives fled-tenant ("หนี") data dumps
OWNER_NOTIFY_EMAIL=sahapap.pht@gmail.com

# LINE Official Account (auto-read transfer slips) — from the LINE Developers console
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# EasySlip — reads + verifies Thai transfer slips sent to the LINE OA.
# Token from https://easyslip.com (developer dashboard).
EASYSLIP_TOKEN=your-easyslip-token

# Secret for the scheduled cleanup cron (/api/cron/cleanup). Set the same value
# in Vercel; Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Any long
# random string.
CRON_SECRET=your-long-random-string
